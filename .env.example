# =============================================================================
# GATEWAY + ARCHANGEL — LOCAL CONFIGURATION AND API KEYS
# Copy this file to .env. NEVER commit .env or paste real keys into source code.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=Gateway
APP_ENV=development
DEBUG=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
SECRET_KEY=replace-with-at-least-32-random-bytes
DATABASE_URL=sqlite:///./gateway.db
SEED_DEMO_DATA=true

# Docker Compose PostgreSQL defaults. Change the password before any shared or
# internet-accessible deployment. Compose overrides DATABASE_URL internally.
POSTGRES_DB=gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=replace-with-strong-database-password

# --- Canonical corpus --------------------------------------------------------
# Full 31,102-verse KJV (1769, public domain), built by scripts/build_kjv_corpus.py
# from the scrollmapper/bible_databases source.
CORPUS_VERSION=kjv-1769-full-2026-07
CORPUS_SEED_PATH=./app/data/kjv_full.json
SOURCE_REGISTRY_PATH=./app/data/source_registry.json

# --- API.Bible ---------------------------------------------------------------
# Official registration/docs:
# https://docs.api.bible/api-reference/getting-started/
# Keep the key server-side. Review plan and translation-specific storage,
# display, commercial-use, and training rights before persisting text.
API_BIBLE_API_KEY=
API_BIBLE_BASE_URL=https://rest.api.bible/v1
API_BIBLE_KJV_ID=de4e12af7f28f599-01

# --- Bible Brain / Digital Bible Platform -----------------------------------
# Official developer docs and API-key request:
# https://www.faithcomesbyhearing.com/bible-brain/api-reference
# https://4.dbt.io/signup
BIBLE_BRAIN_API_KEY=
BIBLE_BRAIN_BASE_URL=https://4.dbt.io/api

# --- Sefaria -----------------------------------------------------------------
# No key is required for the documented public API at the time this foundation
# was created. Review current API and dataset terms before caching or training.
# https://developers.sefaria.org/docs/welcome
SEFARIA_BASE_URL=https://www.sefaria.org/api

# --- Archangel analyzer ------------------------------------------------------
# heuristic                 = deterministic, no external model, default
# anthropic                 = Claude via the Anthropic API (recommended hosted option)
# openai                    = OpenAI Responses API (development fallback only)
# local_openai_compatible   = your own local/open-weight endpoint
ARCHANGEL_ANALYZER=heuristic
ARCHANGEL_ENGINE_VERSION=archangel-foundation-0.1.0
ARCHANGEL_STRICT_CORPUS_ONLY=true
ARCHANGEL_MODEL=
# Analysis prompts carry evidence, context windows, counterpassages, and
# lexical data; a thorough pass takes minutes and runs in the background.
ANALYSIS_TIMEOUT_SECONDS=240

# Hosted general-purpose models are NOT Bible-only trained. They may be used as
# constrained reasoning engines during development, but never describe their
# weights as Bible-only. See docs/MODEL_LIMITATIONS.md.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Local OpenAI-compatible endpoint. This is the path toward a model whose
# approved training corpus and provenance you control.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=local-development
LOCAL_LLM_MODEL=

# --- Safety boundaries (US defaults) ----------------------------------------
SAFETY_COUNTRY=US
EMERGENCY_NUMBER=911
CRISIS_NUMBER=988
POISON_CONTROL_NUMBER=1-800-222-1222

# --- Community and privacy ---------------------------------------------------
MAX_POST_CHARS=16000
MAX_REPLY_CHARS=4000

# --- Open-platform protections ------------------------------------------------
# Shared secret for moderation actions (remove/restore content, list reports).
# Send as the X-Moderation-Token header. Leave empty to disable moderation
# endpoints entirely (they return 503).
MODERATION_TOKEN=
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_POSTS_PER_WINDOW=5
RATE_LIMIT_REPLIES_PER_WINDOW=20
RATE_LIMIT_REPORTS_PER_WINDOW=10
TRAINING_DATA_MODE=consent_reviewed_only
TRAINING_POLICY_VERSION=gateway-training-consent-v1
ENABLE_PRIVATE_CONTENT_TRAINING=false
TRAINING_RETENTION_DAYS=30
PII_HASH_SALT=replace-with-random-secret
FIELD_ENCRYPTION_KEY=
